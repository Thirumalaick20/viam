# What each verb's finished body has to contain. "Not a stub" is not enough:
# the skeleton this page hands over is not a stub either, so a learner who
# pasted it and wrote none of the TODOs used to be told "place is written".
WANTED = {
    "place": [
        (lambda b: b["calls"].count("self.move_gripper") >= 2,
         "TODO 1 and TODO 2: two self.move_gripper(...) calls"),
        (lambda b: "self.gripper.open" in b["calls"],
         "TODO 3: await self.gripper.open()"),
    ],
    "pack": [
        (lambda b: "self.clear_boxes" in b["calls"],
         "TODO 1: await self.clear_boxes()"),
        (lambda b: b["assigns_placed"],
         "TODO 1: self.placed = []"),
        (lambda b: b["loops_place"],
         "TODO 2: a loop calling await self.place()"),
    ],
}


def _body_facts(node):
    """The few things WANTED asks about, gathered in one walk."""
    calls = []
    for n in ast.walk(node):
        func = getattr(n, "func", None)
        if isinstance(n, ast.Call) and isinstance(func, ast.Attribute):
            calls.append(ast.unparse(func))
    assigns_placed = any(
        isinstance(n, ast.Assign)
        and any(ast.unparse(t) == "self.placed" for t in n.targets)
        for n in ast.walk(node))
    loops = (ast.For, ast.AsyncFor, ast.While)
    loops_place = any(
        any(isinstance(c, ast.Call)
            and isinstance(getattr(c, "func", None), ast.Attribute)
            and ast.unparse(c.func) == "self.place"
            for c in ast.walk(loop))
        for loop in ast.walk(node) if isinstance(loop, loops))
    return {"calls": calls, "assigns_placed": assigns_placed,
            "loops_place": loops_place}


def _written(verb):
    node = _method(_source()[1], verb)
    if node is None:
        return _no(f"{verb} is not a method of Palletizer",
                   f"Check the indentation: async def {verb} lines up with"
                   " async def pick.")
    if _is_stub(node):
        return _no(f"{verb} is still the stub that raises NotImplementedError",
                   f"Replace the whole {verb} stub with the skeleton on this"
                   " page.")
    missing = [why for ok, why in WANTED[verb] if not ok(_body_facts(node))]
    if missing:
        return _no(f"{verb} still has empty TODOs",
                   *[f"missing {m}" for m in missing])
    return _ok(f"{verb} is written")


def _routed(verb):
    called = _routes(_source()[1], verb)
    if called is None:
        return _no(f'do_command has no branch for "{verb}"',
                   "Paste the dispatch lines under # Route new verbs here.")
    if verb in called:
        return _ok(f"{verb} -> self.{verb}()")
    if called:
        return _no(f"the {verb} branch calls "
                   f"self.{'(), self.'.join(sorted(called))}(), "
                   f"but never self.{verb}()")
    return _no(f'the "{verb}" branch calls nothing on self')


