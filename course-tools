def cmd_check_exercise(argv):
    """Check one exercise, or one numbered step of it."""
    ap = argparse.ArgumentParser(
        prog="course-tools check-exercise",
        description="Check your work on an exercise. `7` runs every check on "
                    "exercise 7; `7.2` runs just step 2.")
    ap.add_argument("which", help="an exercise (7) or one step of it (7.2)")
    args = ap.parse_args(argv)
    want = args.which.strip()

    if want in EXERCISES:
        ids = [want]
    else:
        ids = [k for k in EXERCISES if k.split(".")[0] == want]
        ids.sort(key=lambda k: int(k.split(".")[1]))
        if not ids:
            have = sorted({k.split(".")[0] for k in EXERCISES}, key=int)
            die(f"no checks for {want!r}. Exercises with checks: "
                f"{', '.join(have)}")

    print(term.bold(f"Exercise {ids[0].split('.')[0]}"))
    failed = False
    for cid in ids:
        ok, lines = EXERCISES[cid]()
        mark = term.pass_() if ok else term.fail()
        print(f"  {term.bold(cid)}  {mark}  {_title(cid)}")
        print(f"        {term.dim(lines[0]) if ok else term.red(lines[0])}")
        for hint in lines[1:]:
            print(f"        {term.yellow(hint)}")
        failed = failed or not ok
    if failed:
        sys.exit(1)


def cmd_start_server(argv):
    """Start viam-server for your machine again, unless it is already running.

    The deciding lives in the workshop image (persist/viam-server-ctl.sh), not here:
    this file comes back from a returning learner's archive and can be older than
    the session, and the agent's post-restore hook must behave exactly like this
    command does. `--restart` stops the running copy first.
    """
    ctl = os.path.join(os.environ.get("WORKSHOP_DIR", "/opt/workshop"),
                       "persist", "viam-server-ctl.sh")
    if not os.path.exists(ctl):
        sys.exit(f"{ctl} is not in this session, so viam-server cannot be started from here.")
    action = "restart" if "--restart" in argv else "start"
    os.execvp("bash", ["bash", ctl, action])


