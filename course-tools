def main():
    ap = argparse.ArgumentParser(
        prog="course-tools", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    # help=SUPPRESS hides the argument, which also removes argparse's
    # "positional arguments: {add-model,check-exercise,...}" block. The
    # curated list in the docstring above is the help a learner should read.
    ap.add_argument("command", nargs="?", choices=sorted(COMMANDS),
                    help=argparse.SUPPRESS)
    args, rest = ap.parse_known_args()
    if not args.command:
        ap.print_help()
        return
    COMMANDS[args.command](rest)


