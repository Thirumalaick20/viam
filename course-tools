def cmd_check(_argv):
    """Report what is wired up and what is still a stub."""
    _meta, namespace, module = load_meta()
    if not os.path.exists(RESOURCE):
        die(f"no {RESOURCE} here. Run this from inside your module directory.")
    src = open(RESOURCE).read()
    try:
        tree = ast.parse(src)
    except SyntaxError as e:
        print(f"  SYNTAX ERROR in {RESOURCE}, line {e.lineno}:")
        print(f"    {(e.text or '').rstrip()}")
        print(f"    {e.msg}")
        print("  Fix this line before reloading: a module with a syntax")
        print("  error deploys, then crashes on the machine with a")
        print("  misleading 'No module named models.palletizer'.")
        sys.exit(1)

    def stubbed(name):
        for node in ast.walk(tree):
            if getattr(node, "name", "") == name:
                body = [n for n in node.body
                        if not (isinstance(n, ast.Expr) and isinstance(n.value, ast.Constant))]
                return len(body) == 1 and isinstance(body[0], ast.Raise)
        return None

    ok = True
    family = f'ModelFamily("{namespace}", "{module}")'
    if family in src:
        print(f"  model family matches meta.json  ({namespace}:{module})")
    else:
        ok = False
        print(f"  MODEL FAMILY does not match meta.json; expected {family}")

    for verb in ("do_command", "place", "pack"):
        state = stubbed(verb)
        if state is None:
            ok = False
            print(f"  {verb} is missing from {RESOURCE}")
        else:
            print(f"  {verb}: {'still a stub' if state else 'written'}")

    models = _meta.get("models") or []
    want = f"{namespace}:{module}:{MODEL_NAME}"
    if not models:
        ok = False
        print("  meta.json has no models list yet")
    elif models[0].get("model") != want:
        ok = False
        print(f"  meta.json model is {models[0].get('model')!r}; expected {want}")
    else:
        print(f"  meta.json lists the model  ({want})")

    validate_src = src.split("def validate_config")[-1].split("def ")[0]
    deps = bool(re.search(r"\bPALLET\b", validate_src))
    print(f"  pallet declared as a dependency: {'yes' if deps else 'not yet'}")

    # A method pasted one indent too deep lands INSIDE the method above it.
    # That parses, so the syntax check above says nothing, and the failure
    # only shows up on the machine as a bare AttributeError. Catch it here.
    cls = next((n for n in ast.walk(tree)
                if isinstance(n, ast.ClassDef) and n.name == "Palletizer"), None)
    if cls is not None:
        defs = (ast.FunctionDef, ast.AsyncFunctionDef)
        top = {n.name for n in cls.body if isinstance(n, defs)}
        nested = {}
        for method in (n for n in cls.body if isinstance(n, defs)):
            for inner in ast.walk(method):
                if inner is not method and isinstance(inner, defs):
                    nested.setdefault(inner.name, (inner.lineno, method.name))
        do_cmd = next((n for n in cls.body
                       if isinstance(n, defs) and n.name == "do_command"), None)
        for node in ast.walk(do_cmd) if do_cmd else ():
            func = getattr(node, "func", None)
            if (isinstance(node, ast.Call)
                    and isinstance(func, ast.Attribute)
                    and isinstance(func.value, ast.Name)
                    and func.value.id == "self"
                    and func.attr not in top
                    and func.attr in nested):
                line, parent = nested[func.attr]
                ok = False
                print(f"  do_command routes to self.{func.attr}(), but that")
                print(f"  method is defined INSIDE {parent}() on line {line}.")
                print(f"  Outdent `async def {func.attr}` so it lines up with")
                print("  `async def pick`, four spaces in.")

    if not ok:
        sys.exit(1)


# --------------------------------------------------------------- exercises
# One numbered check per thing a page asked the learner to do, so
# `course-tools check-exercise 7.1` answers "did I get TODO 1 right?" and
# nothing else. `check-module` still runs the whole sweep; the pages use the
# numbered form because a learner mid-exercise wants one answer, not fifteen.
#
# Exercises 4 and 10 have no checks here on purpose: what they ask for lives
# in the registry and on GitHub, and a check that has to authenticate and
# call the cloud fails for reasons that have nothing to do with the
# learner's work.


def _source():
    """The learner's resource file, parsed. Returns (src, tree)."""
    if not os.path.exists(RESOURCE):
        die(f"no {RESOURCE} here. Run this from inside your module directory.")
    src = open(RESOURCE).read()
    try:
        return src, ast.parse(src)
    except SyntaxError as e:
        print(f"  {term.red('SYNTAX ERROR')} in {RESOURCE}, line {e.lineno}:")
        print(f"    {(e.text or '').rstrip()}")
        print(f"    {e.msg}")
        sys.exit(1)


def _class(tree):
    return next((n for n in ast.walk(tree)
                 if isinstance(n, ast.ClassDef) and n.name == "Palletizer"),
                None)


def _method(tree, name):
    """The method as a class-level def, or None if it is missing or nested."""
    cls = _class(tree)
    if cls is None:
        return None
    defs = (ast.FunctionDef, ast.AsyncFunctionDef)
    return next((n for n in cls.body if isinstance(n, defs) and n.name == name),
                None)


def _is_stub(node):
    body = [n for n in node.body
            if not (isinstance(n, ast.Expr) and isinstance(n.value, ast.Constant))]
    return len(body) == 1 and isinstance(body[0], ast.Raise)


def _method_src(tree, name):
    node = _method(tree, name)
    return ast.unparse(node) if node is not None else ""


def _routes(tree, verb):
    """Every self.<attr>() the `if verb == "<verb>"` branch calls.

    A set, not the first one found: a learner who prints something through
    self before returning has still routed the verb correctly, and the
    first version of this failed them for it. None means there is no
    branch for the verb at all, which is a different answer from "the
    branch is there and calls the wrong thing".
    """
    node = _method(tree, "do_command")
    if node is None:
        return None
    for test in ast.walk(node):
        if not isinstance(test, ast.If):
            continue
        cmp_ = test.test
        if not (isinstance(cmp_, ast.Compare)
                and cmp_.comparators
                and isinstance(cmp_.comparators[0], ast.Constant)
                and cmp_.comparators[0].value == verb):
            continue
        called = set()
        for call in ast.walk(test):
            func = getattr(call, "func", None)
            if (isinstance(call, ast.Call) and isinstance(func, ast.Attribute)
                    and isinstance(func.value, ast.Name)
                    and func.value.id == "self"):
                called.add(func.attr)
        return called
    return None


def _env_has(key):
    """read_env() dies when the file is missing; a check wants a row."""
    if not os.path.exists(os.path.expanduser("~/.viam-102-env")):
