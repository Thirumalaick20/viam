#!/usr/bin/env python3
"""Course chores.

Everything in here is bookkeeping the course needs and a Viam developer does
not: copying a file into place, keeping two strings in a manifest agreeing with
each other, reading a value back out. None of it is worth a learner's memory,
and printing it on a page as a wall of Python teaches the wrong thing, so it
lives behind names that say what it does.

    course-tools setup-machine      create the machine and the course location
    course-tools start-server       start viam-server again (never a second copy)
    course-tools check-namespace    claim your organization's public namespace
    course-tools check-names        make sure your module name is free
    course-tools setup-github       sign in to GitHub and get ready to push
    course-tools copy-starter-code  copy the starter in, keeping your model name
    course-tools add-model          add this module's model to meta.json
    course-tools model-id           print the model triplet
    course-tools print-urls         print the machine's app page links
    course-tools print-env          print the saved environment values
    course-tools print-all          print all of the above
    course-tools check-exercise 7   check your work on exercise 7
    course-tools check-exercise 7.2 check just step 2 of exercise 7
"""

import argparse
import ast
import shutil
import shlex
import re
import json
import os
import subprocess
import sys

# realpath, not abspath: this is run through a symlink on PATH, and its
# siblings (setup-machine.py, the starter) live beside the real file.
HERE = os.path.dirname(os.path.realpath(__file__))
STARTER = os.path.join(HERE, "course-files", "palletizer-starter.py")
sys.path.insert(0, os.path.join(HERE, "course-files"))
import term  # noqa: E402  (needs HERE on the path first)
RESOURCE = os.path.join("src", "models", "palletizer.py")
MODEL_NAME = "palletizer"


def die(msg):
    sys.exit(f"course-tools: {msg}")


def _prompt_with_default(prompt, default):
    """input(), with `default` already typed on the line and editable.

    A bracketed default asks the learner to know that blank means "use it".
    readline can pre-fill the line instead, so Enter accepts and backspace
    edits. Without a terminal there is nothing to pre-fill, and input()
    behaves as it always did.
    """
    try:
        import readline
    except ImportError:
        return input(f"{prompt}[{default}] ")
    if not sys.stdin.isatty():
        return input(prompt) or default

    def preload():
        readline.insert_text(default)
        readline.redisplay()

    readline.set_startup_hook(preload)
    try:
        return input(prompt)
    finally:
        readline.set_startup_hook()


def load_meta():
    if not os.path.exists("meta.json"):
        die("no meta.json here. Run this from inside your module directory, "
            "the one `viam module generate` made.")
    try:
        with open("meta.json") as f:
            meta = json.load(f)
    except json.JSONDecodeError as e:
        die(f"meta.json does not parse: {e}. A missing comma or a stray one "
            "is the usual cause; fix it in the Editor and rerun this.")
    if ":" not in meta.get("module_id", ""):
        die(f"meta.json has an odd module_id: {meta.get('module_id')!r}")
    namespace, module = meta["module_id"].split(":", 1)
    return meta, namespace, module


def cmd_setup_machine(argv):
    """Delegate to the machine setup script, passing its flags through."""
    script = os.path.join(HERE, "course-files", "setup-machine.py")
    raise SystemExit(subprocess.call([sys.executable, script] + argv))


def cmd_check_namespace(argv):
    """Make sure the organization has a public namespace, claiming one if not.

    Registering a module requires the organization to have claimed a public
    namespace, and a fresh personal organization has none: `viam module
    generate` walks all of its prompts and then refuses at the very end.
    Checking here fails fast, and turns the fix into one prompt.
    """
    import re

    ap = argparse.ArgumentParser(prog="course-tools check-namespace")
    ap.add_argument("--org", help="organization id (default: the one "
                    "setup-machine saved)")
    args = ap.parse_args(argv)
    org_id = args.org or read_env().get("VIAM_102_ORG_ID")
    if not org_id:
        die("no organization recorded; run `course-tools setup-machine` "
            "first or pass --org")

    def viam(cli_args):
        p = subprocess.run(["viam"] + cli_args, capture_output=True, text=True)
        if p.returncode != 0:
            die(f"`viam {' '.join(cli_args)}` failed: "
                f"{(p.stderr or p.stdout).strip()}")
        return p.stdout

    def suggest():
        """A memorable default with nothing personal in it.

        The namespace is public, so the default must not leak a name
        or an email, and learners find it again in the registry later,
        so it should be memorable: adjective + color + a robot word,
        picked deterministically from the organization id. The
        platform requires lowercase, so braveyellowdroid, not
        braveYellowDroid.
        """
        sizes = ["little", "brave", "happy", "swift", "quiet", "clever",
                 "mighty", "gentle", "lucky", "shiny", "sunny", "zippy",
                 "calm", "bold", "witty", "spry"]
        colors = ["red", "orange", "yellow", "green", "blue", "purple",
                  "silver", "golden", "copper", "teal", "coral", "amber",
                  "violet", "crimson", "jade", "pearl"]
        robots = ["robot", "droid", "bot", "automaton", "machine",
                  "mech", "rover", "android"]
        h = re.sub(r"[^0-9a-f]", "", org_id.lower())
        return (sizes[int(h[:4], 16) % 16]
                + colors[int(h[4:8], 16) % 16]
                + robots[int(h[8:12], 16) % 8])

    async def run():
        from viam.app.viam_client import ViamClient
        from viam.rpc.dial import DialOptions, Credentials

        raw = viam(["organizations", "api-key", "create", "--org-id", org_id,
                    "--name", "viam-102-namespace-check"])
        kid = re.search(r"Key ID:\s*(\S+)", raw)
        kval = re.search(r"Key Value:\s*(\S+)", raw)
        if not (kid and kval):
            die("could not read the new API key from the CLI output; claim a "
                "namespace in the app instead, under organization settings")
        key_id, key_val = kid.group(1), kval.group(1)
        client = await ViamClient.create_from_dial_options(DialOptions(
            credentials=Credentials(type="api-key", payload=key_val),
            auth_entity=key_id))
        try:
            app = client.app_client
            orgs = await app.list_organizations()
            org = next((o for o in orgs if o.id == org_id), None)
            if org is None:
                die(f"organization {org_id} not found for this login")
            if org.public_namespace:
                save_env("VIAM_102_NAMESPACE", org.public_namespace)
                print(f"public namespace: {org.public_namespace} "
                      "(already claimed, nothing to do)")
                return

            candidate = suggest()
            while candidate and not await                     app.get_organization_namespace_availability(candidate):
                candidate += "102"

            print(f"Your organization ({org.name}) has no public namespace.")
            print("Module IDs live under it, like namespace:palletizer-102.")
            print("It is PUBLIC and PERMANENT, so pick deliberately, and")
            print("only put your name in it if you want it public. A")
            print("username you already use elsewhere works well; the")
            print("suggestion is an anonymous fallback.")
            print("Lowercase letters and digits only.")
            while True:
                try:
                    picked = _prompt_with_default(
                        "Public namespace: ", candidate).strip()
                except EOFError:
                    picked = ""
                picked = picked or candidate
                if not re.fullmatch(r"[a-z][a-z0-9]*", picked or ""):
                    print("lowercase letters and digits only, starting "
                          "with a letter; try again")
                    continue
                if not await                         app.get_organization_namespace_availability(picked):
                    print(f"{picked} is taken; try another")
                    continue
                break
            await app.update_organization(org_id, public_namespace=picked)
            save_env("VIAM_102_NAMESPACE", picked)
            print(f"public namespace claimed: {picked}")
        finally:
            try:
                await app.delete_key(key_id)
            except Exception:
                print(f"note: could not revoke the check key {key_id}; "
                      "delete it in the app under organization settings")
            client.close()

    import asyncio
    asyncio.run(run())


# The course's module name. Pages show it, and their Editor links open files
# under ~/exercises/palletizer-102, which copy-starter-code keeps pointing at
# the learner's module when check-names had to pick another name.
DEFAULT_MODULE = "palletizer-102"
EXERCISES_DIR = os.path.expanduser("~/exercises")
# `viam module generate`'s own rule for a module name (rdk cli/module_generate.go).
MODULE_NAME_RE = r"[a-zA-Z]+(?:[_\-a-zA-Z0-9]+)*"
# GitHub's rule for a repository name; "." and ".." are refused.
REPO_NAME_RE = r"(?!\.{1,2}$)[A-Za-z0-9._-]{1,100}"


def _local_module(name, namespace):
    """What ~/exercises/<name> is: "yours", "taken" or None (nothing there).

    "yours" is a module this learner generated under this namespace, which a
    returning learner's restored home holds; it must never read as a clash.
    """
    path = os.path.join(EXERCISES_DIR, name)
    try:
        with open(os.path.join(path, "meta.json")) as f:
            if json.load(f).get("module_id") == f"{namespace}:{name}":
                return "yours"
    except (OSError, ValueError, AttributeError):
        pass
    return "taken" if os.path.lexists(path) else None


async def _registered(app, module_id):
    """The registry's module for `module_id`, or None when there is none."""
    from grpclib.const import Status
    from grpclib.exceptions import GRPCError
    try:
        return await app.get_module(module_id)
    except GRPCError as e:
        if e.status == Status.NOT_FOUND:
            return None
        raise


async def _module_state(app, name, namespace):
    """("yours" | "free" | "registered" | "local", registry module or None)."""
    local = _local_module(name, namespace)
    if local == "yours":
        return "yours", None
    module = await _registered(app, f"{namespace}:{name}")
    if module is not None:
        return "registered", module
    return ("local" if local else "free"), None


def _next_names(name, default):
    """palletizer-102 -> palletizer-102-2, -3, ...; any other name -> name-2, ..."""
    m = re.fullmatch(rf"({re.escape(default)})(?:-\d+)?", name)
    base = m.group(1) if m else name
    return (f"{base}-{i}" for i in range(2, 100))


def _ask_name(prompt, suggestion, pattern, rule, ask):
    """Prompt until the learner accepts the suggestion or types a valid name.

    Enter takes the pre-filled suggestion; so does end of input, so a piped
    run still finishes. Whether the name is free is the caller's check.
    """
    while True:
        try:
            picked = ask(prompt, suggestion).strip()
        except EOFError:
            print()
            picked = ""
        picked = picked or suggestion
        if re.fullmatch(pattern, picked):
            return picked
        print(rule)


def choose_module_name(state_of, namespace, name, ask):
    """Return a module name that `viam module generate` can register.

    `state_of(name)` is _module_state for one name. The prompts stay out of
    the event loop: inside asyncio.run the first Ctrl-C only cancels the task
    while input() keeps waiting, and the second is a traceback.
    """
    state, module = state_of(name)
    if state == "yours":
        print(f"module name: {term.cyan(name)} (your module from earlier in "
              f"the course, in ~/exercises/{name})")
        return name
    if state == "free":
        print(f"module name: {term.cyan(name)} (free in {namespace})")
        return name

    if state == "registered":
        versions = [v.version for v in module.versions]
        print(term.yellow(
            f"{namespace}:{name} is already registered in your organization"
            + (f" (versions {', '.join(versions)})" if versions else "") + "."))
        print("It is left from an earlier run of this course, or a teammate in")
        print("the same organization made it. A module can be registered only")
        print("once, so use a different module name for this course.")
    else:
        print(term.yellow(f"~/exercises/{name} already exists and is not your "
                          f"{namespace}:{name} module."))
        print("`viam module generate` will not create a module over it, so use")
        print("a different module name for this course.")

    suggestion = None
    for candidate in _next_names(name, DEFAULT_MODULE):
        if state_of(candidate)[0] in ("free", "yours"):
            suggestion = candidate
            break
    if suggestion is None:
        die("could not find a free module name to suggest; pass one with "
            "`course-tools check-names --module <name>`")

    while True:
        picked = _ask_name("Module name: ", suggestion, MODULE_NAME_RE,
                           "letters, digits, dashes and underscores only, "
                           "starting with a letter", ask)
        state, _ = state_of(picked)
        if state in ("free", "yours"):
            print(f"module name: {term.cyan(picked)}")
            return picked
        print(f"{picked}: " + ("already registered in your organization"
                               if state == "registered"
                               else f"~/exercises/{picked} already exists")
              + "; try another")


def _start_name(explicit, saved, namespace):
    """The module name to check first.

    The one asked for, else the saved one, else the module that
    ~/exercises/palletizer-102 links to (the env file can be lost while the
    link copy-starter-code made survives), else the course's.
    """
    if explicit or saved:
        return explicit or saved
    link = os.path.join(EXERCISES_DIR, DEFAULT_MODULE)
    if os.path.islink(link):
        target = os.path.basename(os.path.realpath(link))
        if _local_module(target, namespace) == "yours":
            return target
    return DEFAULT_MODULE


async def _open_registry(token):
    """(channel, app client) that read as the CLI's logged-in user."""
    from grpclib.client import Channel
    from viam.app.app_client import AppClient
    channel = Channel("app.viam.com", 443, ssl=True)
    return channel, AppClient(channel, {"authorization": f"Bearer {token}"})


def cmd_check_names(argv):
    """Make sure the course's module name is free before the module is made.

    A module name is registered once per organization. A learner retaking the
    course, or a teammate in the same organization, already holds
    `<namespace>:palletizer-102`, and `viam module generate` then fails at the
    very end with nothing on the page saying why. Checking here, right after
    the namespace is known, turns that into one prompt with a free name.

    Reads through the CLI's own login: nothing is created in the organization.
    """
    ap = argparse.ArgumentParser(prog="course-tools check-names")
    ap.add_argument("--module", help="module name to check (default: the "
                    f"saved one, else {DEFAULT_MODULE})")
    args = ap.parse_args(argv)
    env = read_env()
    namespace = env.get("VIAM_102_NAMESPACE")
    if not namespace:
        die("no public namespace recorded; run `course-tools check-namespace "
            "&& source ~/.viam-102-env` first")
    name = _start_name(args.module, env.get("VIAM_102_MODULE"), namespace)
    if not re.fullmatch(MODULE_NAME_RE, name):
        die(f"{name!r} is not a valid module name: letters, digits, dashes and "
            "underscores only, starting with a letter")

    try:
        p = subprocess.run(["viam", "login", "print-access-token"],
                           capture_output=True, text=True)
    except FileNotFoundError:
        die("the Viam CLI is not installed; run the curl and chmod commands "
            "at the top of this page, then `viam login`")
    token = p.stdout.strip()
    if p.returncode != 0 or not token:
        die("the Viam CLI is not logged in; run `viam login`, then this again")

    import asyncio
    from grpclib.exceptions import GRPCError
    loop = asyncio.new_event_loop()
    channel = None
    try:
        channel, app = loop.run_until_complete(_open_registry(token))
        picked = choose_module_name(
            lambda n: loop.run_until_complete(_module_state(app, n, namespace)),
            namespace, name, _prompt_with_default)
    except GRPCError as e:
        from grpclib.const import Status
        hint = ("; run `viam login`, then this again"
                if e.status in (Status.UNAUTHENTICATED, Status.PERMISSION_DENIED)
                else "")
        die(f"could not check the registry: {e.message or e.status.name}{hint}")
    except OSError as e:
        # grpclib connects on the first call and re-raises socket and TLS errors
        # as they are, so an unreachable app.viam.com is not a GRPCError.
        die(f"could not reach app.viam.com ({e.strerror or e}); check this "
            "session's network, then run this again")
    except KeyboardInterrupt:
        print()
        die("stopped; no module name was saved")
    finally:
        if channel is not None:
            channel.close()
        loop.close()
    save_env("VIAM_102_MODULE", picked)
    # What check 2.4 looks for: an env file written before check-names
    # existed already holds VIAM_102_MODULE, with nothing having checked it.
    save_env("VIAM_102_MODULE_CHECKED", picked)
    print(f"saved VIAM_102_MODULE={picked} to ~/.viam-102-env")
    print("The GitHub repository name is checked later, on the cloud build "
          "page, once you sign in to GitHub.")


def cmd_setup_github(_argv):
    """Sign in to GitHub and make this module directory ready to push.

    Four chores, none worth a learner's memory: the gh device-code
    sign-in, teaching git to push with that sign-in, setting the commit
    identity from it (username and GitHub's no-reply address, so no
    personal email lands in commits), and removing the generated
    .github workflow, a release automation the course does not use.
    """
    def gh(*args, capture=False):
        if capture:
            p = subprocess.run(["gh"] + list(args),
                               capture_output=True, text=True)
            return p.returncode, p.stdout.strip()
        return subprocess.call(["gh"] + list(args)), ""

    if not os.path.exists("meta.json"):
        die("no meta.json here. Run this from inside your module "
            "directory, the one `viam module generate` made.")

    code, _ = gh("auth", "status", capture=True)
    if code == 0:
        print("GitHub: already signed in")
    else:
        code, _ = gh("auth", "login", "--hostname", "github.com",
                     "--git-protocol", "https", "--web")
        if code != 0:
            die("GitHub sign-in did not finish; run "
                "`course-tools setup-github` again")
    gh("auth", "setup-git", capture=True)

    _, login = gh("api", "user", "-q", ".login", capture=True)
    _, uid = gh("api", "user", "-q", ".id", capture=True)
    if not (login and uid):
        die("could not read your GitHub username; run "
            "`course-tools setup-github` again")
    email = f"{uid}+{login}@users.noreply.github.com"
    subprocess.call(["git", "config", "--global", "user.name", login])
    subprocess.call(["git", "config", "--global", "user.email", email])
    print(f"git identity: {login} <{email}>")

    if os.path.isdir(".github"):
        import shutil
        shutil.rmtree(".github")
        print("removed .github: the generated release workflow, "
              "which this course does not use")
    else:
        print(".github: already gone")

    # Signing in is the first moment the GitHub account is known, so this is
    # the earliest the repository name can be checked.
    _meta, _namespace, module = load_meta()
    saved = read_env()["VIAM_102_REPO"] if _env_has("VIAM_102_REPO") else None
    origin = subprocess.run(["git", "remote", "get-url", "origin"],
                            capture_output=True, text=True).stdout.strip()
    try:
        repo = choose_repo_name(login,
                                _repo_start_name(saved, module, login, origin),
                                lambda name: _repo_exists(login, name), origin,
                                _prompt_with_default)
    except KeyboardInterrupt:
        print()
        die("stopped; no repository name was saved")
    save_env("VIAM_102_REPO", repo)
    print(f"repository: {term.cyan(f'https://github.com/{login}/{repo}')}")
    print("  saved as VIAM_102_REPO; that address is the url meta.json gets")


def _same_repo(origin, login, name):
    """Whether git's origin URL is github.com/<login>/<name>."""
    return origin.removesuffix(".git") == f"https://github.com/{login}/{name}"


def _repo_start_name(saved, module, login, origin):
    """The saved repository name while this directory pushes to it, else the
    module's name. A name saved for a module since generated again under
    another name must not win over the module in front of the learner."""
    return saved if saved and _same_repo(origin, login, saved) else module


def _repo_exists(login, name):
    """Whether github.com/<login>/<name> exists.

    Anything but a clear yes or no stops the command: guessing "free" only
    moves the failure to `gh repo create`.
    """
    p = subprocess.run(["gh", "api", f"repos/{login}/{name}", "--silent"],
                       capture_output=True, text=True)
    if p.returncode == 0:
        return True
    if "HTTP 404" in p.stderr:
        return False
    die(f"could not ask GitHub about {login}/{name}: {p.stderr.strip()}")


def choose_repo_name(login, name, exists, origin, ask):
    """Return a repository name `gh repo create` can use for this module.

    The module's own name, unless the GitHub account already has a repository
    by that name. The repository this directory already pushes to is the
    learner's, from an earlier pass through the page, and never a clash.
    """
    def usable(candidate):
        if not exists(candidate):
            return True
        return _same_repo(origin, login, candidate)

    if usable(name):
        return name
    print(term.yellow(f"github.com/{login}/{name} already exists."))
    print("It is left from an earlier run of this course, or it is another")
    print("project of yours. Use a different repository name for this course.")
    suggestion = next((c for c in _next_names(name, DEFAULT_MODULE)
                       if usable(c)), None)
    if suggestion is None:
        die("could not find a free repository name to suggest")
    while True:
        picked = _ask_name("Repository name: ", suggestion, REPO_NAME_RE,
                           "letters, digits, dots, dashes and underscores "
                           "only", ask)
        if usable(picked):
            return picked
        print(f"{picked}: github.com/{login}/{picked} already exists; "
              "try another")


def _link_course_path():
    """Make the pages' Editor links reach this module when its name differs.

    An Editor link on a page names a literal path, ~/exercises/palletizer-102/...,
    and cannot read $VIAM_102_MODULE. When check-names picked another name, a
    link ~/exercises/palletizer-102 -> <that name> sends every one of them to
    the learner's module. Relative, so it still resolves after the session
    archive brings the home directory back.
    """
    here = os.path.realpath(os.getcwd())
    if os.path.dirname(here) != os.path.realpath(EXERCISES_DIR):
        return
    name = os.path.basename(here)
    link = os.path.join(EXERCISES_DIR, DEFAULT_MODULE)
    if name == DEFAULT_MODULE:
        return
    if os.path.islink(link) and not os.path.exists(link):
        os.unlink(link)  # dangling: the directory it named is gone
    if os.path.islink(link) and os.path.realpath(link) == here:
        return
    if os.path.lexists(link):
        print(term.yellow(
            f"note: ~/exercises/{DEFAULT_MODULE} is a different directory, so "
            "the Editor links on the pages open files there, not in your "
            f"module. Open your files from ~/exercises/{name} in the Editor's "
            "file list instead."))
        return
    os.symlink(name, link)
    print(f"  Linked ~/exercises/{DEFAULT_MODULE} -> {name}, so the Editor "
          "links on the pages open your module")


def cmd_take_starter(_argv):
    """Copy the course starter over the generated resource file.

    The starter names a placeholder namespace, and the generated file it
    replaces named the real one, so the model family is restored from the
    manifest rather than retyped.
    """
    meta, namespace, module = load_meta()
    if not os.path.exists(RESOURCE):
        die(f"no {RESOURCE} here. Run this from inside your module directory.")
    with open(STARTER) as f:
        body = f.read()
    body = body.replace('ModelFamily("your-namespace", "palletizer-102")',
                        f'ModelFamily("{namespace}", "{module}")')
    with open(RESOURCE, "w") as f:
        f.write(body)
    print(f"{term.bold('Copying the starter code')} - {term.green('FINISHED')}")
    print(f"{RESOURCE} is now the course starter")
    print(f"  Using the model family: {term.cyan(f'{namespace}:{module}')}")
    _link_course_path()
    # The generate prompt is editable, so the name typed there wins over the
    # one check-names saved; later pages cd by the saved one.
    save_env("VIAM_102_MODULE", module)


def cmd_describe_model(_argv):
    """Add this module's model to meta.json, so the registry can list it."""
    meta, namespace, module = load_meta()
    meta["models"] = [{
        "api": "rdk:service:generic",
        "model": f"{namespace}:{module}:{MODEL_NAME}",
        "markdown_link": f"{namespace}_{module}_{MODEL_NAME}.md",
    }]
    meta.setdefault("description",
                    "Picks boxes from a pick-station and stacks them on a pallet.")
    with open("meta.json", "w") as f:
        json.dump(meta, f, indent=2)
        f.write("\n")
    save_env("VIAM_102_MODULE", module)
    print("meta.json now describes one model:")
    print(json.dumps(meta["models"][0], indent=2))


def save_env(key, value):
    """Add or update one export line in ~/.viam-102-env."""
    env = os.path.expanduser("~/.viam-102-env")
    lines = open(env).readlines() if os.path.exists(env) else []
    lines = [ln if ln.endswith("\n") else ln + "\n" for ln in lines]
    lines = [ln for ln in lines if not ln.startswith(f"export {key}=")]
    lines.append(f"export {key}={shlex.quote(str(value))}\n")
    open(env, "w").writelines(lines)


def read_env():
    env = os.path.expanduser("~/.viam-102-env")
    if not os.path.exists(env):
        die("no machine yet: run `course-tools setup-machine` first")
    values = {}
    for line in open(env):
        if line.startswith("export ") and "=" in line:
            k, v = line[len("export "):].split("=", 1)
            values[k.strip()] = _unquote(v)
    return values


def _unquote(value):
    """The value of an `export KEY=<value>` line, as the shell reads it."""
    try:
        words = shlex.split(value)
    except ValueError:
        return value.strip().strip('"')
    return words[0] if words else ""


